# --- Required for all tools -------------------------------------------------
# API key from https://www.bungie.net/en/Application
BUNGIE_API_KEY=

# --- Required only for authenticated tools (write actions, "me" lookups) -----
# OAuth client id + secret from the same Bungie application page.
# Use a "Confidential" app type to get a client secret.
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# Must EXACTLY match the redirect URL registered on the Bungie application.
# The built-in `auth` command listens on this URL to capture the auth code.
BUNGIE_REDIRECT_URI=https://localhost:7777/callback
BUNGIE_OAUTH_PORT=7777

# Where tokens and the cached manifest are stored. Defaults to ~/.d2-mcp
# D2_MCP_DATA_DIR=

# Optional: require `Authorization: Bearer <token>` on the /mcp + WebSocket
# transports. Strongly recommended when binding to a non-loopback interface.
# D2_MCP_AUTH_TOKEN=

# Optional: comma-separated browser origins allowed to connect (requests with
# any other Origin header are rejected). Only needed for browser-based clients.
# D2_MCP_ALLOWED_ORIGINS=http://localhost:6274

# Optional: how often (minutes) to auto-refresh the authenticated account's
# inventory snapshot. Default 60, minimum 5.
# D2_MCP_INVENTORY_REFRESH_MINUTES=60

# Optional: close Streamable HTTP sessions idle this many minutes (default 30).
# Clients get a 404 on their next request and re-initialize automatically.
# D2_MCP_SESSION_IDLE_MINUTES=30
